{
  "manifest_version": 3,
  "name": "CV Smart Assistant",
  "version": "2.1",
  "description": "Extract data from PDF resumes, autofill forms, and filter LinkedIn jobs",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "CV Smart Assistant"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"]
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": [
        "src/lib/linkedinStorage.js",
        "src/content/linkedinDOM.js",
        "src/content/linkedinUI.js",
        "src/content/linkedinContent.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
