# ─────────────────────────────────────────────────────────────────────────────
# CPX Labs — Environment Variables
# Copy this file to .env.local and fill in the values before running locally.
# On Vercel, set these via the Vercel Dashboard → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contact Form ──────────────────────────────────────────────────────────────
# The e-mail address that receives contact form submissions.
CONTACT_TO_EMAIL=contato@cpxlabs.com.br

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Fill these if you want the /api/contact route to send e-mails via SMTP.
# Providers: Gmail, SendGrid SMTP relay, Mailgun, Brevo (Sendinblue), etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@cpxlabs.com.br
SMTP_PASS=your-smtp-password

# ── Site URL ──────────────────────────────────────────────────────────────────
# Set to your production domain after deploying to Vercel.
# Example: https://cpxlabs.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
