# ─────────────────────────────────────────────────────────────────────────────
# CPX Labs — Environment Variables
# Copy this file to .env.local and fill in the values before running locally.
# On Vercel, set these via the Vercel Dashboard → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contact Form ──────────────────────────────────────────────────────────────
# The e-mail address that receives contact form submissions.
CONTACT_TO_EMAIL=contato@cpxlabs.com.br

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Fill these if you want the /api/contact route to send e-mails via SMTP.
# Providers: Gmail, SendGrid SMTP relay, Mailgun, Brevo (Sendinblue), etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@cpxlabs.com.br
SMTP_PASS=your-smtp-password

# ── Site URL ──────────────────────────────────────────────────────────────────
# Set to your production domain after deploying to Vercel.
# Example: https://cpxlabs.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── YouTube Download Jobs (optional, disabled by default) ─────────────────────
# This app only submits and tracks jobs. The actual download/conversion work
# must run in a separate worker service with yt-dlp/ffmpeg and object storage.
# Only enable this for content you own or are authorized to process.
YOUTUBE_DOWNLOADS_ENABLED=false
MEDIA_WORKER_BASE_URL=https://media-worker.example.com
MEDIA_WORKER_API_KEY=your-media-worker-api-key

# Optional public base URL used to expand relative download paths returned by the
# worker into absolute download links.
MEDIA_STORAGE_PUBLIC_URL=https://storage.example.com/downloads

# Basic per-IP throttling for POST /api/youtube-downloads.
YOUTUBE_DOWNLOAD_RATE_LIMIT_MAX=5
YOUTUBE_DOWNLOAD_RATE_LIMIT_WINDOW_MS=600000
