# ─────────────────────────────────────────────────────────────────────────────
# CPX Labs — Environment Variables
# Copy this file to .env.local and fill in the values before running locally.
# On Vercel, set these via the Vercel Dashboard → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contact Form ──────────────────────────────────────────────────────────────
# The e-mail address that receives contact form submissions.
CONTACT_TO_EMAIL=contato@cpxlabs.com.br

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Fill these if you want the /api/contact route to send e-mails via SMTP.
# Providers: Gmail, SendGrid SMTP relay, Mailgun, Brevo (Sendinblue), etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@cpxlabs.com.br
SMTP_PASS=your-smtp-password

# ── WhatsApp Cloud API + AI webhook (optional) ────────────────────────────────
# Enable these to summarize incoming long WhatsApp messages through /api/whatsapp/webhook.
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=choose-a-random-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ADMIN_NUMBER=5521999999999
WHATSAPP_BUSINESS_PHONE_NUMBER=5521975542783
WHATSAPP_MIN_SUMMARY_CHARACTERS=150
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_AI_MODEL=gemini-2.5-flash
WHATSAPP_AI_TIMEOUT_MS=8000
GEMINI_API_KEY=your-gemini-api-key

# ── Site URL ──────────────────────────────────────────────────────────────────
# Set to your production domain after deploying to Vercel.
# Example: https://cpxlabs.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
