# URL pública do site (ex.: https://cpxlabs.com.br)
NEXT_PUBLIC_SITE_URL=

# E-mail que recebe os contatos do formulário
CONTACT_TO_EMAIL=

# SMTP (opcional — sem SMTP, submissões são logadas apenas)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# WhatsApp Cloud API (opcional — necessário para o webhook)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ADMIN_NUMBER=
# WHATSAPP_BUSINESS_PHONE_NUMBER=
# WHATSAPP_MIN_SUMMARY_CHARACTERS=200
# WHATSAPP_GRAPH_API_VERSION=v21.0

# Google Gemini (opcional — usado para resumir mensagens do WhatsApp)
# GEMINI_API_KEY=
# WHATSAPP_AI_MODEL=gemini-2.5-flash
# WHATSAPP_AI_TIMEOUT_MS=10000
